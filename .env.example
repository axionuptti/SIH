# NASA FIRMS API Key (Map key from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_API_KEY=your_firms_map_key_here

# Optional Alert Notification Configurations
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ISRO MOSDAC Credentials (Optional)
MOSDAC_USERNAME=your_username
MOSDAC_PASSWORD=your_password
MOSDAC_API_URL=https://mosdac.gov.in/api/v1/active-fire
